# Production settings for docker-compose.yml. On the server, copy this file to
# .env, which git ignores, and fill it in. Only its owner should be able to read it.

# Public hostname. Caddy gets the certificate for this name, and the portal
# calls the API at https://<SITE_DOMAIN>/api.
SITE_DOMAIN=davhi.se.rit.edu

# Certificates come from RIT's ACME server, which requires External Account
# Binding (EAB). Sign in at https://acme.rit.edu with RIT SSO and create EAB
# credentials: a key ID and an HMAC key. Caddy then gets and renews the
# certificate itself.
ACME_EMAIL=
ACME_EAB_KEY_ID=
ACME_EAB_MAC_KEY=

# Optional. Posts deploy progress to a Discord channel. In Discord: Edit
# Channel > Integrations > Webhooks > Copy Webhook URL. Anyone with the URL can
# post to the channel, so keep it out of git.
DISCORD_WEBHOOK_URL=

# Cloudflare R2 storage for media uploads
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public URL of the R2 bucket. It's baked into the portal at build time, so
# changing it takes effect on the next deploy.
VITE_R2_BUCKET_URL=
